# ==============================================================================
# AgentChain AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
# cp .env.example .env
# NOTE: Never commit production credentials or private keys to source control.

# ------------------------------------------------------------------------------
# Backend & API Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database (e.g. postgresql+asyncpg://agentchain:agentchain@localhost:5432/agentchain_db)
# Or for local lightweight testing without postgres installed: sqlite+aiosqlite:///./agentchain.db
DATABASE_URL=sqlite+aiosqlite:///./agentchain.db

# JWT Authentication
JWT_SECRET=replace-with-a-secure-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# AI Agent & LLM Configuration
# ------------------------------------------------------------------------------
# Provider: 'gemini', 'openai', or 'mock' (mock allows local testing without external API key)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash
MAX_TOKENS=2048
TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# Blockchain & EVM Configuration
# ------------------------------------------------------------------------------
# Local Hardhat Node: http://127.0.0.1:8545 (ChainID: 31337)
# Sepolia Testnet: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY (ChainID: 11155111)
ETHEREUM_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Deployed Smart Contract Addresses (Populated after deploying contracts)
AGENT_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
POLICY_MANAGER_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
ACTION_LEDGER_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
REWARD_VAULT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# Test Deployer & Signer Configuration (Development only - NEVER use mainnet keys here)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ------------------------------------------------------------------------------
# Frontend Vite Environment (Accessible via import.meta.env.VITE_*)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
VITE_AGENT_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_POLICY_MANAGER_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
VITE_ACTION_LEDGER_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
VITE_REWARD_VAULT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
VITE_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io

