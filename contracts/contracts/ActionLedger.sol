pragma solidity ^0.8.24;

import "@openzeppelin/contracts/access/AccessControl.sol";
import "@openzeppelin/contracts/utils/Pausable.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

interface IAgentRegistry {
    function isAgentActive(address agentAddress) external view returns (bool);
}

interface IPolicyManager {
    function validateAction(
        bytes32 operationType,
        address target,
        uint256 amount
    ) external view returns (bool isValid, string memory reason);

    function recordExecution(bytes32 operationType, address target) external;
}

/**
 * @title ActionLedger
 * @notice Immutable verifiable ledger for AI-generated blockchain action proposals and approvals.
 * @dev Enforces duplicate action prevention, policy validation, human authorization, and reentrancy protection.
 */
contract ActionLedger is AccessControl, Pausable, ReentrancyGuard {
    bytes32 public constant OPERATOR_ROLE = keccak256("OPERATOR_ROLE");

    enum ActionStatus {
        None,
        Proposed,
        Approved,
        Executed,
        Rejected
    }

    struct ActionRecord {
        bytes32 actionId;
        bytes32 proposalHash;
        bytes32 operationType;
        address agent;
        address target;
        uint256 value;
        bytes callData;
        address approvedBy;
        ActionStatus status;
        uint256 proposedAt;
        uint256 approvedAt;
        uint256 executedAt;
        string rejectionReason;
    }

    IAgentRegistry public agentRegistry;
    IPolicyManager public policyManager;

    mapping(bytes32 => ActionRecord) private _actions;
    bytes32[] private _actionIds;

    // Events
    event ActionProposed(
        bytes32 indexed actionId,
        bytes32 indexed proposalHash,
        bytes32 indexed operationType,
        address agent,
        address target,
        uint256 value,
        bytes callData,
        uint256 timestamp
    );

    event ActionApproved(
        bytes32 indexed actionId,
        address indexed approvedBy,
        uint256 timestamp
    );

    event ActionExecuted(
        bytes32 indexed actionId,
        address indexed executor,
        bytes returnData,
        uint256 timestamp
    );

    event ActionRejected(
        bytes32 indexed actionId,
        address indexed rejectedBy,
        string reason,
        uint256 timestamp
    );

    event PolicyManagerUpdated(address indexed oldAddress, address indexed newAddress);
    event AgentRegistryUpdated(address indexed oldAddress, address indexed newAddress);

    // Errors
    error ActionAlreadyExists(bytes32 actionId);
    error ActionNotFound(bytes32 actionId);
    error InvalidActionStatus(bytes32 actionId, ActionStatus expected, ActionStatus actual);
    error InactiveAgent(address agent);
    error PolicyViolation(string reason);
    error ExecutionFailed(bytes returnData);
    error InvalidContractAddress();
    error InsufficientValue();

    constructor(
        address admin,
        address _agentRegistry,
        address _policyManager
    ) {
        if (admin == address(0) || _agentRegistry == address(0) || _policyManager == address(0)) {
            revert InvalidContractAddress();
        }
        _grantRole(DEFAULT_ADMIN_ROLE, admin);
        _grantRole(OPERATOR_ROLE, admin);

        agentRegistry = IAgentRegistry(_agentRegistry);
        policyManager = IPolicyManager(_policyManager);
    }

    /**
     * @notice Compute verifiable cryptographic proposal hash.
     */
    function computeProposalHash(
        bytes32 actionId,
        bytes32 operationType,
        address agent,
        address target,
        uint256 value,
        bytes calldata callData
    ) public pure returns (bytes32) {
        return keccak256(
            abi.encode(actionId, operationType, agent, target, value, keccak256(callData))
        );
    }

    /**
     * @notice Submit a new action proposal generated by an AI agent.
     */
    function proposeAction(
        bytes32 actionId,
        bytes32 operationType,
        address target,
        uint256 value,
        bytes calldata callData
    ) external whenNotPaused nonReentrant returns (bytes32) {
        if (_actions[actionId].status != ActionStatus.None) {
            revert ActionAlreadyExists(actionId);
        }

        // Validate that caller agent is registered and active
        if (!agentRegistry.isAgentActive(msg.sender)) {
            revert InactiveAgent(msg.sender);
        }

        // Validate initial policy compliance
        (bool isValid, string memory reason) = policyManager.validateAction(
            operationType,
            target,
            value
        );
        if (!isValid) {
            revert PolicyViolation(reason);
        }

        bytes32 proposalHash = computeProposalHash(
            actionId,
            operationType,
            msg.sender,
            target,
            value,
            callData
        );

        _actions[actionId] = ActionRecord({
            actionId: actionId,
            proposalHash: proposalHash,
            operationType: operationType,
            agent: msg.sender,
            target: target,
            value: value,
            callData: callData,
            approvedBy: address(0),
            status: ActionStatus.Proposed,
            proposedAt: block.timestamp,
            approvedAt: 0,
            executedAt: 0,
            rejectionReason: ""
        });

        _actionIds.push(actionId);

        emit ActionProposed(
            actionId,
            proposalHash,
            operationType,
            msg.sender,
            target,
            value,
            callData,
            block.timestamp
        );

        return proposalHash;
    }

    /**
     * @notice Approve and immediately execute an action with human authorization.
     */
    function approveAndExecuteAction(
        bytes32 actionId
    ) external payable whenNotPaused nonReentrant returns (bytes memory) {
        ActionRecord storage action = _actions[actionId];
        if (action.status == ActionStatus.None) revert ActionNotFound(actionId);
        if (action.status != ActionStatus.Proposed && action.status != ActionStatus.Approved) {
            revert InvalidActionStatus(actionId, ActionStatus.Proposed, action.status);
        }

        if (msg.value < action.value) {
            revert InsufficientValue();
        }

        // Re-validate against policy before execution
        (bool isValid, string memory reason) = policyManager.validateAction(
            action.operationType,
            action.target,
            action.value
        );
        if (!isValid) {
            revert PolicyViolation(reason);
        }

        action.approvedBy = msg.sender;
        action.approvedAt = block.timestamp;
        action.status = ActionStatus.Executed;
        action.executedAt = block.timestamp;

        emit ActionApproved(actionId, msg.sender, block.timestamp);

        // Execute call to target
        (bool success, bytes memory returnData) = action.target.call{value: action.value}(action.callData);
        if (!success) {
            action.status = ActionStatus.Proposed; // Revert status on failure
            revert ExecutionFailed(returnData);
        }

        // Record execution in PolicyManager to update cooldowns
        policyManager.recordExecution(action.operationType, action.target);

        emit ActionExecuted(actionId, msg.sender, returnData, block.timestamp);

        return returnData;
    }

    /**
     * @notice Approve an action for subsequent execution.
     */
    function approveAction(
        bytes32 actionId
    ) external whenNotPaused {
        ActionRecord storage action = _actions[actionId];
        if (action.status == ActionStatus.None) revert ActionNotFound(actionId);
        if (action.status != ActionStatus.Proposed) {
            revert InvalidActionStatus(actionId, ActionStatus.Proposed, action.status);
        }

        action.approvedBy = msg.sender;
        action.approvedAt = block.timestamp;
        action.status = ActionStatus.Approved;

        emit ActionApproved(actionId, msg.sender, block.timestamp);
    }

    /**
     * @notice Reject an action proposal with a documented reason.
     */
    function rejectAction(
        bytes32 actionId,
        string calldata reason
    ) external whenNotPaused {
        ActionRecord storage action = _actions[actionId];
        if (action.status == ActionStatus.None) revert ActionNotFound(actionId);
        if (action.status != ActionStatus.Proposed && action.status != ActionStatus.Approved) {
            revert InvalidActionStatus(actionId, ActionStatus.Proposed, action.status);
        }

        action.status = ActionStatus.Rejected;
        action.rejectionReason = reason;

        emit ActionRejected(actionId, msg.sender, reason, block.timestamp);
    }

    /**
     * @notice Get action record details.
     */
    function getAction(bytes32 actionId) external view returns (ActionRecord memory) {
        ActionRecord memory action = _actions[actionId];
        if (action.status == ActionStatus.None) revert ActionNotFound(actionId);
        return action;
    }

    /**
     * @notice Get total number of recorded actions.
     */
    function getActionCount() external view returns (uint256) {
        return _actionIds.length;
    }

    /**
     * @notice Get all recorded action IDs.
     */
    function getAllActionIds() external view returns (bytes32[] memory) {
        return _actionIds;
    }

    /**
     * @notice Update PolicyManager contract reference.
     */
    function setPolicyManager(address newPolicyManager) external onlyRole(DEFAULT_ADMIN_ROLE) {
        if (newPolicyManager == address(0)) revert InvalidContractAddress();
        address old = address(policyManager);
        policyManager = IPolicyManager(newPolicyManager);
        emit PolicyManagerUpdated(old, newPolicyManager);
    }

    /**
     * @notice Update AgentRegistry contract reference.
     */
    function setAgentRegistry(address newAgentRegistry) external onlyRole(DEFAULT_ADMIN_ROLE) {
        if (newAgentRegistry == address(0)) revert InvalidContractAddress();
        address old = address(agentRegistry);
        agentRegistry = IAgentRegistry(newAgentRegistry);
        emit AgentRegistryUpdated(old, newAgentRegistry);
    }

    function pause() external onlyRole(DEFAULT_ADMIN_ROLE) {
        _pause();
    }

    function unpause() external onlyRole(DEFAULT_ADMIN_ROLE) {
        _unpause();
    }

    receive() external payable {}
}

